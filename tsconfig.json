{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": { "@/*": ["./frontend/*"] },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["backend/**/*.ts", "prisma7.config.ts", "prisma/**/*.ts"]
}
